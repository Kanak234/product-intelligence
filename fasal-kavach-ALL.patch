+class TestJsonParsing:
+    def test_plain_json(self):
+        assert _parse_json('{"a": 1}') == {"a": 1}
+
+    def test_fenced_json(self):
+        assert _parse_json('```json\n{"a": 1}\n```') == {"a": 1}
+
+    def test_bare_fence(self):
